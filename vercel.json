{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/cloud-config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "report"
        }
      ],
      "destination": "/report.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "report"
        }
      ],
      "destination": "/report.html",
      "permanent": false
    }
  ],
  "proxy": {
    "entrypoint": "proxy.js"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gubae-announcements-api.onrender.com/api/:path*"
    }
  ]
}
