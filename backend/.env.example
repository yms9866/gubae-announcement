PORT=10000
FIREBASE_PROJECT_ID=your-project-id
# Set this as a Render secret environment variable; never put credentials in frontend files.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Public Firebase Web app config JSON: apiKey, authDomain, projectId, appId.
FIREBASE_WEB_CONFIG_JSON=
# Comma-separated Google sign-in emails allowed to administer this dashboard.
ADMIN_EMAILS=your-google-email@example.com
ALLOWED_ORIGINS=https://gubae-announcements.yosefmogesie.chatgpt.site
FRONTEND_URL=https://gubae-announcements.yosefmogesie.chatgpt.site
